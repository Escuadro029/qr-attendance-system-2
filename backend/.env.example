# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the Web Service dashboard instead.

PORT=4000

# Render Postgres "External Database URL" (or "Internal Database URL" if backend
# and DB are both on Render, which is faster and free of egress fees)
DATABASE_URL=postgresql://user:password@host.singapore-postgres.render.com/dbname

# Set to true only if connecting to a non-Render Postgres that requires SSL
PGSSL=false

# Generate your own long random string — never reuse the example below,
# and never commit a real value here.
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed frontend origins, e.g.
# https://qr-attendance-frontend.onrender.com
CORS_ORIGIN=*

# Used once by `npm run seed`: resolves (or creates) the tenant that the
# seeded categories/admin login belong to.
SEED_TENANT_NAME=The Press Conference School
SEED_TENANT_INDUSTRY=education

# Used once by `npm run seed` to create the first login
SEED_ADMIN_EMAIL=admin@school.edu.ph
SEED_ADMIN_PASSWORD=change-this-before-first-run

# Cloudinary account (free tier is fine) — used to host uploaded certificate
# logos and the principal's e-signature instead of storing them as base64
# blobs in Postgres. Get these from your Cloudinary dashboard's "API
# Environment variable" box. Either set the single CLOUDINARY_URL below, OR
# the three separate vars — you don't need both.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
